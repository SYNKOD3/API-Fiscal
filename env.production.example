POSTGRES_DB=fiscal_api
POSTGRES_USER=fiscal_api
POSTGRES_PASSWORD=troque-por-uma-senha-forte-do-postgres

APP_API_KEY=troque-por-uma-chave-de-api-com-mais-de-24-caracteres
APP_SECRETS_KEY=troque-por-uma-chave-fixa-com-mais-de-32-caracteres
JWT_AUTH_ENABLED=true
JWT_SECRET=troque-por-uma-chave-jwt-com-mais-de-32-caracteres
JWT_ISSUER=fiscal-platform
JWT_AUDIENCE=fiscal-api

FISCAL_PROVIDER=LIBRARY
FISCAL_UNAVAILABLE_STATES=
CERTIFICATE_STORAGE_PATH=/var/lib/fiscal-api/certificates
CERTIFICATE_MAX_SIZE_BYTES=5242880
APP_DEV_CONSOLE_ENABLED=false
OPENAPI_ENABLED=false
OPENAPI_PUBLIC_ACCESS=false

POSTGRES_DB=fiscal_api
POSTGRES_USER=fiscal_api
POSTGRES_PASSWORD=troque-por-uma-senha-forte-do-postgres

APP_SECRETS_KEY=troque-por-uma-chave-fixa-com-mais-de-32-caracteres

BASIC_AUTH_ENABLED=false
AUTH_USERNAME=
AUTH_PASSWORD=

API_KEY_AUTH_ENABLED=true
APP_API_KEY=troque-por-uma-chave-de-api-com-mais-de-24-caracteres

JWT_AUTH_ENABLED=false
JWT_SECRET=troque-por-uma-chave-jwt-com-mais-de-32-caracteres
JWT_ISSUER=fiscal-platform
JWT_AUDIENCE=fiscal-api
AUTH_DEFAULT_SCOPES=fiscal:companies:write,fiscal:companies:read,fiscal:certificates:write,fiscal:certificates:read,fiscal:documents:issue,fiscal:documents:retry,fiscal:documents:read,fiscal:audit:read,fiscal:logs:read,fiscal:sefaz:read
AUTH_TOKEN_TTL_MINUTES=60

FISCAL_PROVIDER=LIBRARY
FISCAL_UNAVAILABLE_STATES=
# Pasta com os XSD da SEFAZ, usados para validar o XML antes de assinar. Eles
# nao vem na java-nfe nem existem como artefato Maven: baixe o pacote de
# liberacao da SEFAZ e aponte para a pasta. Enquanto ela nao existir, a emissao
# segue sem a validacao local e o log avisa a cada emissao.
FISCAL_SCHEMAS_PATH=/var/lib/fiscal-api/schemas
CERTIFICATE_STORAGE_PATH=/var/lib/fiscal-api/certificates
CERTIFICATE_MAX_SIZE_BYTES=5242880
# Token compartilhado com a plataforma integradora quando o certificado fica fora da API Fiscal.
CERTIFICATE_REMOTE_AUTH_TOKEN=troque-por-token-forte-compartilhado
APP_DEV_CONSOLE_ENABLED=false
OPENAPI_ENABLED=false
OPENAPI_PUBLIC_ACCESS=false
